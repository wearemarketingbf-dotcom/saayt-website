---
// Site assistant (automatic, no AI): answers from src/data/faq.<lang>.json, falls back to site search,
// always offers WhatsApp (when set) and the demo page. Keeps nothing: no storage, no cookies, no network except Pagefind
// Only the launcher is in the page. The panel script and the FAQ load when the browser is idle or on first click
import { type Lang, url } from '../i18n/util';
import { CONFIG } from '../config';
import faqAr from '../data/faq.ar.json';
import faqEn from '../data/faq.en.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';

// fail the build early if an editor saves an FAQ entry in the wrong shape
for (const [name, list] of [['faq.ar.json', faqAr], ['faq.en.json', faqEn]] as const) {
  if (!Array.isArray(list)) throw new Error(`src/data/${name} must be a list of questions`);
  (list as unknown[]).forEach((it: any, i) => {
    const bad = !it || typeof it.q !== 'string' || !it.q.trim() || typeof it.a !== 'string' || !it.a.trim()
      || !Array.isArray(it.tags) || it.tags.some((t: unknown) => typeof t !== 'string')
      || (it.link !== undefined && (typeof it.link !== 'string' || !/^(\/|https?:\/\/)/.test(it.link)));
    if (bad) throw new Error(`src/data/${name} item ${i + 1} needs q and a (text), tags (list of words) and an optional link starting with / or https://`);
  });
}
const show = !Astro.url.pathname.includes('/admin/');
const wa = CONFIG.whatsapp ? `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(ar ? 'السلام عليكم ودي أعرف أكثر عن صيت' : 'Hi, I would like to know more about SAAYT')}` : '';
const label = ar ? 'اسأل مساعد صيت الآلي' : 'Ask SAAYT’s automatic assistant';
---
{show && (
  <div class="ast" data-ast data-wa={wa || undefined} data-demo={url(lang, 'demo/')}>
    <button class="ast__btn" type="button" data-ast-open aria-haspopup="dialog" aria-expanded="false" aria-controls="ast-panel" title={label}>
      <svg class="ast__ico" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 4.5h14a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2h-7.5L7 20.5V17H5a2 2 0 0 1-2-2V6.5a2 2 0 0 1 2-2z" /><path d="M12 7.2c0 1.7 1.6 3.3 3.3 3.3-1.7 0-3.3 1.6-3.3 3.3 0-1.7-1.6-3.3-3.3-3.3 1.7 0 3.3-1.6 3.3-3.3z" fill="currentColor" stroke="none" /></svg>
      <svg class="ast__icx" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      <span class="sr-only">{label}</span>
    </button>
  </div>
)}

<style is:global>
  .ast { --ast-b: 16px; position: fixed; z-index: 45; inset-inline-end: 16px; bottom: calc(var(--ast-b) + env(safe-area-inset-bottom)); transition: bottom .35s var(--ease) }
  .ast.is-open { z-index: 65 }
  .ast.is-held:not(.is-open) .ast__btn { visibility: hidden }
  .ast__btn { width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; background: var(--green-900); color: var(--sand-100); border: 1.5px solid rgba(245, 239, 228, .28); transition: background-color .2s, transform .3s var(--ease) }
  .ast__btn:hover { background: var(--green-800) }
  .ast__btn:active { transform: scale(.95) }
  html[dir='rtl'] .ast__ico { transform: scaleX(-1) }
  .ast__icx { display: none }
  .ast.is-open .ast__ico { display: none }
  .ast.is-open .ast__icx { display: block }
  .ast__panel { position: absolute; bottom: calc(100% + 12px); inset-inline-end: 0; width: min(390px, calc(100vw - 32px)); max-height: min(620px, calc(100vh - var(--ast-b) - 170px)); display: flex; flex-direction: column; background: var(--surface); color: var(--text); border: 1px solid var(--green-900); border-radius: var(--r-lg); overflow: hidden; transform-origin: bottom right; animation: ast-in .28s var(--ease) }
  html[dir='rtl'] .ast__panel { transform-origin: bottom left }
  .ast__panel[hidden] { display: none }
  @keyframes ast-in { from { opacity: 0; transform: translateY(10px) scale(.98) } }
  .ast__head { display: flex; align-items: flex-start; gap: 12px; padding: 16px 16px 14px; background: var(--green-900); color: var(--sand-100); flex: none }
  .ast__av { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 12px; background: rgba(245, 239, 228, .1); color: var(--saffron-400) }
  .ast__head h2 { font-size: 1.02rem; line-height: 1.4; font-weight: 700 }
  .ast__head p { font-size: .82rem; line-height: 1.5; color: var(--green-300); margin-top: 2px }
  .ast__x { margin-inline-start: auto; width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 50%; margin-top: -4px; margin-inline-end: -6px }
  .ast__x:hover { background: rgba(245, 239, 228, .1) }
  .ast__head :focus-visible { outline-color: var(--saffron-400) }
  .ast__log { flex: 1; min-height: 120px; overflow-y: auto; overscroll-behavior: contain; padding: 16px; display: flex; flex-direction: column; gap: 12px; font-size: .95rem; line-height: 1.7 }
  .ast__log:focus-visible { outline-offset: -3px }
  .ast__m { max-width: 92%; padding: 10px 14px; border-radius: 16px; overflow-wrap: anywhere }
  .ast__m--bot { align-self: flex-start; background: var(--bg); border: 1px solid var(--line); border-start-start-radius: 4px }
  .ast__m--me { align-self: flex-end; background: var(--green-100); color: var(--green-950); border-start-end-radius: 4px }
  .ast__more { display: inline-flex; margin-top: 8px; font-weight: 600; color: var(--green-700); text-decoration: underline; text-underline-offset: 3px }
  .ast__hits { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px }
  .ast__hits a { display: block; padding: 8px 10px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line) }
  .ast__hits a:hover { border-color: var(--green-900) }
  .ast__hits b { display: block; font-weight: 600; font-size: .92rem; line-height: 1.5 }
  .ast__hits small { color: var(--green-700); font-size: .78rem; font-weight: 600 }
  .ast__hand { margin-top: 8px; color: var(--muted); font-size: .9rem }
  .ast__hand a { color: var(--green-700); font-weight: 600; text-decoration: underline; text-underline-offset: 3px }
  .ast__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px }
  .ast__chips p { width: 100%; font-size: .82rem; color: var(--muted) }
  .ast__chip { text-align: start; padding: 7px 12px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--green-900); font-size: .88rem; font-weight: 500; line-height: 1.5 }
  .ast__chip:hover { border-color: var(--green-900) }
  .ast__form { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--line); flex: none }
  .ast__form input { flex: 1; min-width: 0; height: 46px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--bg); color: var(--text); font: inherit; font-size: 1rem }
  .ast__form input:focus { outline: none; border-color: var(--green-700); box-shadow: 0 0 0 3px var(--green-100) }
  .ast__send { width: 46px; height: 46px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--green-900); color: var(--sand-100) }
  .ast__send:hover { background: var(--green-800) }
  html[dir='rtl'] .ast__send svg { transform: scaleX(-1) }
  .ast__acts { display: flex; gap: 8px; padding: 0 12px 12px; flex: none }
  .ast__acts .btn { --h: 42px; flex: 1; padding: 0 12px; font-size: .9rem }
  @media (max-width: 560px) {
    .ast__btn { width: 50px; height: 50px }
    .ast__panel { position: fixed; inset-inline: 0; bottom: 0; width: 100%; max-height: min(86vh, 86dvh); border-radius: var(--r-lg) var(--r-lg) 0 0; border-width: 1px 0 0; padding-bottom: env(safe-area-inset-bottom); transform-origin: bottom center; animation-name: ast-up }
    html[dir='rtl'] .ast__panel { transform-origin: bottom center }
    @keyframes ast-up { from { transform: translateY(24px); opacity: 0 } }
    .ast.is-open .ast__btn { visibility: hidden }
  }
  @media (prefers-reduced-motion: reduce) { .ast, .ast__btn { transition: none } .ast__panel { animation: none } }
  @media print { .ast { display: none } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ast]');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('[data-ast-open]')!;
    type Api = { toggle(): void };
    let api: Promise<Api> | null = null;
    const load = () => (api ??= import('../scripts/assistant').then((m) => m.mount(root, btn)));
    btn.addEventListener('click', () => { load().then((a) => a.toggle()).catch(() => { api = null; }); });
    const idle = (window as any).requestIdleCallback as ((cb: () => void, o?: object) => void) | undefined;
    const later = () => { load().catch(() => { api = null; }); };
    if (document.readyState === 'complete') (idle ? idle(later, { timeout: 4000 }) : setTimeout(later, 2500));
    else addEventListener('load', () => (idle ? idle(later, { timeout: 4000 }) : setTimeout(later, 2500)), { once: true });

    // keep the launcher clear of the mobile bottom bar and the cookie banner
    const bar = document.querySelector<HTMLElement>('[data-mbar]');
    const cns = document.querySelector<HTMLElement>('[data-consent]');
    const overlaps = (r: DOMRect, me: DOMRect) => r.width > 0 && r.left < me.right && r.right > me.left;
    let raf = 0;
    const place = () => {
      raf = 0;
      const me = btn.getBoundingClientRect();
      let b = 16;
      if (bar && bar.classList.contains('show') && getComputedStyle(bar).display !== 'none') b = Math.max(b, bar.offsetHeight + 12);
      // phones: wait until the cookie banner is answered (stacking both would cover the page); wider screens: sit above it
      let held = false;
      if (cns && !cns.hidden) { const r = cns.getBoundingClientRect(); if (overlaps(r, me)) { if (innerWidth <= 760) held = true; else b = Math.max(b, innerHeight - r.top + 12); } }
      root.classList.toggle('is-held', held);
      root.style.setProperty('--ast-b', `${Math.round(b)}px`);
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(place); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    const mo = new MutationObserver(queue);
    if (bar) mo.observe(bar, { attributes: true, attributeFilter: ['class'] });
    if (cns) mo.observe(cns, { attributes: true, attributeFilter: ['hidden'] });
    place();
  }
</script>

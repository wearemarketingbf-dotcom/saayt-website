---
// Analytics consent · GA runs cookieless until the visitor agrees (matches the privacy policy)
import { type Lang, url } from '../i18n/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
---
<div class="cns" data-consent hidden role="region" aria-label={ar ? 'ملفات التحليل' : 'Analytics cookies'}>
  <p>{ar ? 'نستخدم ملفات تحليل بسيطة نعرف منها أي الصفحات تفيدك أكثر' : 'We use simple analytics cookies to learn which pages help you most'} <a href={url(lang, 'privacy/')}>{ar ? 'سياسة الخصوصية' : 'Privacy Policy'}</a></p>
  <div class="cns__btns">
    <button class="btn btn--primary cns__b" type="button" data-c="yes">{ar ? 'موافق' : 'Accept'}</button>
    <button class="btn btn--light-ghost cns__b" type="button" data-c="no">{ar ? 'لا شكرًا' : 'No thanks'}</button>
  </div>
</div>
<style>
  .cns { position: fixed; z-index: 60; inset-inline: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); max-width: 560px; margin-inline: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; padding: 16px 18px; background: var(--surface); color: var(--text); border: 1px solid var(--green-900); border-radius: var(--r-lg, 18px) }
  .cns p { margin: 0; flex: 1 1 240px; font-size: .95rem; line-height: 1.6 }
  .cns a { color: var(--green-700); text-decoration: underline; text-underline-offset: 3px }
  .cns__btns { display: flex; gap: 10px }
  .cns__b { --h: 44px; padding: 0 20px; font-size: .95rem }
  @media (max-width: 760px) { .cns { bottom: calc(84px + env(safe-area-inset-bottom)) } }
</style>
<script is:inline>
  (function () {
    var box = document.querySelector('[data-consent]'); if (!box) return;
    var v = null; try { v = localStorage.getItem('saayt.consent'); } catch (e) {}
    if (v) return;
    box.hidden = false;
    box.addEventListener('click', function (e) {
      var b = e.target.closest('[data-c]'); if (!b) return;
      var c = b.getAttribute('data-c');
      try { localStorage.setItem('saayt.consent', c); } catch (err) {}
      if (c === 'yes' && window.gtag) gtag('consent', 'update', { analytics_storage: 'granted' });
      box.hidden = true;
    });
  })();
</script>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import FAQ from '../sections/FAQ.astro';
import CTABand from '../CTABand.astro';
import HoursMock from '../ui/HoursMock.astro';
import ReviewsMock from '../ui/ReviewsMock.astro';
import AlertsMock from '../ui/AlertsMock.astro';
import DetailsMock from '../ui/DetailsMock.astro';
import { type Lang, url, crumbsLd, faqLd } from '../../i18n/util';
import { FEATURES, NAV } from '../../i18n/nav';
import { FEATURE_PAGES, type FeatureSlug } from '../../data/features';
interface Props { lang: Lang; slug: FeatureSlug }
const { lang, slug } = Astro.props;
const P = FEATURE_PAGES[lang][slug];
const N = NAV(lang);
const ar = lang === 'ar';
const path = `features/${slug}/`;
const trail = [{ name: N.features, path: 'features/' }, { name: P.eyebrow, path }];
const site = Astro.site!.toString();
const svc = { '@context': 'https://schema.org', '@type': 'Service', name: P.h1, description: P.seo.description, provider: { '@type': 'Organization', name: 'SAAYT' }, areaServed: 'SA', serviceType: P.eyebrow };
const others = FEATURES.filter((f) => f.slug !== slug);
---
<Base lang={lang} title={P.seo.title} description={P.seo.description} path={path} dark jsonld={[crumbsLd(lang, site, trail), faqLd(P.faq), svc]}>
  <PageHero lang={lang} eyebrow={P.eyebrow} title={P.h1} lead={P.lead} crumbs={trail} />

  <section class="section fp-demo">
    <div class="wrap fp-demo__in">
      <div class="fp-demo__mock">
        {slug === 'hours' && <HoursMock lang={lang} />}
        {slug === 'reviews' && <ReviewsMock lang={lang} />}
        {slug === 'alerts' && <AlertsMock lang={lang} variant="alerts" />}
        {slug === 'photos-details' && <DetailsMock lang={lang} />}
        {slug === 'branch-score' && <AlertsMock lang={lang} variant="score" />}
      </div>
      <div>
        <h2 class="h2" data-reveal>{P.why.h2}</h2>
        <div class="fp-why" data-stagger="100">
          {P.why.items.map((it, i) => <div class="fp-why__it"><span class="num">0{i + 1}</span><div><b>{it.t}</b><p>{it.d}</p></div></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head"><h2 class="h2" data-reveal>{P.caps.h2}</h2></div>
      <div class="grid grid-3" data-stagger="80">
        {P.caps.items.map((c) => <div class="card fp-cap"><span class="fp-cap__i"><Icon name={c.icon} size={22} /></span><h3>{c.t}</h3><p>{c.d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--center"><h2 class="h2" data-reveal>{P.flow.h2}</h2></div>
      <ol class="fp-flow" data-stagger="120">
        {P.flow.steps.map((s, i) => <li><span class="fp-flow__n num">{i + 1}</span><b>{s.t}</b><p>{s.d}</p></li>)}
      </ol>
      <div class="fp-guard" data-reveal><Icon name="shield" size={26} /><div><b>{P.guard.t}</b><p>{P.guard.d}</p></div></div>
    </div>
  </section>

  <FAQ eyebrow={ar ? 'أسئلة عن الميزة' : 'Questions'} title={ar ? 'قبل ما تسأل' : 'Before you ask'} items={P.faq} />

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head"><h2 class="h2" data-reveal>{ar ? 'مزايا ثانية تشتغل معها' : 'Works well with'}</h2></div>
      <div class="grid grid-4" data-stagger="80">
        {others.map((f) => <a class="card fp-rel" href={url(lang, `features/${f.slug}/`)}><Icon name={f.icon} size={22} /><b>{f[lang].t}</b><p>{f[lang].d}</p><Icon name="arrow" size={18} class="arrow" /></a>)}
      </div>
    </div>
  </section>

  <CTABand lang={lang} />
</Base>
<style>
  .fp-demo__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 6vw, 96px); align-items: center }
  .fp-demo__mock { max-width: 520px; width: 100%; justify-self: center }
  .fp-why { display: grid; gap: 14px; margin-top: 28px }
  .fp-why__it { display: flex; gap: 16px; padding: 18px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md) }
  .fp-why__it .num { color: var(--saffron-700); font-weight: 700 }
  .fp-why__it p { color: var(--muted); font-size: .98rem }
  .fp-cap__i { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--green-100); color: var(--green-700); margin-bottom: 18px }
  .fp-cap h3 { font-size: 1.15rem }
  .fp-cap p { color: var(--muted); margin-top: 6px; font-size: .98rem }
  .fp-flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; counter-reset: s }
  .fp-flow li { position: relative; padding: 26px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line) }
  .fp-flow__n { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--green-900); color: var(--saffron-400); font-weight: 700; margin-bottom: 16px }
  .fp-flow b { font-size: 1.15rem; display: block }
  .fp-flow p { color: var(--muted); margin-top: 4px }
  .fp-guard { display: flex; gap: 16px; align-items: flex-start; margin-top: 24px; padding: 22px 24px; border-radius: var(--r-lg); background: var(--green-900); color: var(--sand-100) }
  .fp-guard :global(.icon) { color: var(--saffron-400); flex: none; margin-top: 2px }
  .fp-guard p { color: var(--green-300) }
  .fp-rel { display: grid; gap: 8px; align-content: start; transition: border-color .3s, transform .4s var(--ease) }
  .fp-rel:hover { border-color: var(--green-700); transform: translateY(-3px) }
  .fp-rel > :global(.icon:first-child) { color: var(--saffron-500) }
  .fp-rel p { color: var(--muted); font-size: .95rem }
  .fp-rel :global(.arrow) { color: var(--green-700); margin-top: 6px }
  @media (max-width: 900px) { .fp-demo__in, .fp-flow { grid-template-columns: 1fr } }
</style>

---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { type Lang, url, crumbsLd } from '../../i18n/util';
import { NAV, FEATURES } from '../../i18n/nav';
import { SCAN } from '../../data/scan';
import { CONFIG } from '../../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const N = NAV(lang);
const S = SCAN[lang];
const T = ar ? {
  seo: { title: 'فحص مجاني لفروعك على قوقل ماب | صيت', description: 'اعرف حالة كل فرع على Google خلال دقائق — اكتمال البيانات وأوقات العمل والتقييمات بلا رد — مجاناً وبدون التزام' },
  h1: 'افحص فروعك في دقيقتين', lead: '12 سؤال عن المواعيد والبيانات والصور والتقييمات وفي النهاية تطلع لك درجة وأولويات واضحة بدون تسجيل وبدون ما نقرأ أي بيانات',
  yes: 'نعم', part: 'بعض الفروع', no: 'لا', of: 'من', weight: 'الوزن', progress: 'جاوبت على', result: 'نتيجتك',
  bands: [{ min: 80, t: 'وضع فروعك ممتاز', d: 'باقي تفاصيل بسيطة وتقدر تحافظ على المستوى بمتابعة منتظمة' }, { min: 55, t: 'أساس جيد يحتاج ترتيب', d: 'فيه نقاط واضحة لو صححتها بيتحسن انطباع العميل عن فروعك' }, { min: 0, t: 'فروعك تحتاج اهتمام', d: 'العميل غالبًا يشوف معلومات ناقصة أو قديمة ابدأ بالأولويات تحت' }],
  prio: 'أولوياتك', none: 'ما عندك أولويات عاجلة', learn: 'كيف يساعدك صيت', demo: 'احجز عرضًا ونراجعها معك', print: 'اطبع النتيجة', wa: 'أرسل النتيجة على واتساب', reset: 'أعد الفحص',
  method: 'طريقة الحساب', methodD: 'كل سؤال له وزن ظاهر جنبه ومجموع الأوزان 100 الإجابة بنعم تعطي الوزن كامل وبعض الفروع نصفه ولا صفر هذه أداة تقييم ذاتي وليست قراءة من Google ولا مقارنة بأنشطة ثانية',
  privacy: 'إجاباتك تبقى في متصفحك وما تنرسل لنا', see: 'شوف النتيجة', need: 'جاوب على كل الأسئلة عشان تطلع النتيجة',
} : {
  seo: { title: 'Free Google Maps Scan for Your Branches | SAAYT', description: 'See how every branch looks on Google in minutes — profile completeness · hours and unanswered reviews — free with no commitment' },
  h1: 'Scan your branches in two minutes', lead: '12 questions about hours, details, photos and reviews. At the end you get a score and clear priorities. No sign-up and we never read your data',
  yes: 'Yes', part: 'Some branches', no: 'No', of: 'of', weight: 'Weight', progress: 'Answered', result: 'Your result',
  bands: [{ min: 80, t: 'Your branches are in great shape', d: 'A few small details remain and regular follow-up keeps you there' }, { min: 55, t: 'A good base that needs order', d: 'There are clear points that will improve how customers see your branches' }, { min: 0, t: 'Your branches need attention', d: 'Customers probably see missing or outdated information. Start with the priorities below' }],
  prio: 'Your priorities', none: 'No urgent priorities', learn: 'How SAAYT helps', demo: 'Book a demo and we’ll review them with you', print: 'Print the result', wa: 'Send the result on WhatsApp', reset: 'Restart',
  method: 'How it is calculated', methodD: 'Each question has a weight shown beside it and the weights add up to 100. Yes earns the full weight, Some branches earns half and No earns zero. This is a self-assessment, not a reading from Google and not a comparison with other businesses',
  privacy: 'Your answers stay in your browser and are never sent to us', see: 'See my result', need: 'Answer every question to see your result',
};
const featName = Object.fromEntries(FEATURES.map((f) => [f.slug, f[lang].t]));
const trail = [{ name: N.scan, path: 'free-scan/' }];
const areas = Object.keys(S.areas) as (keyof typeof S.areas)[];
const data = { qs: S.qs, areas: S.areas, bands: T.bands, feat: featName, featUrl: Object.fromEntries(FEATURES.map((f) => [f.slug, url(lang, `features/${f.slug}/`)])), wa: CONFIG.whatsapp, demo: url(lang, 'demo/'), lang };
---
<Base lang={lang} title={T.seo.title} description={T.seo.description} path="free-scan/" dark jsonld={[crumbsLd(lang, Astro.site!.toString(), trail)]}>
  <PageHero lang={lang} eyebrow={N.scan} title={T.h1} lead={T.lead} crumbs={trail} cta={false} compact />
  <section class="section sc" data-scan>
    <div class="wrap sc__in">
      <form class="sc__form" novalidate>
        <div class="sc__prog" aria-live="polite"><span>{T.progress} <b class="num" data-count>0</b> {T.of} <span class="num">12</span></span><i><em data-bar></em></i></div>
        {areas.map((a) => (
          <fieldset class="sc__area">
            <legend>{S.areas[a]}</legend>
            {S.qs.filter((q) => q.area === a).map((q) => (
              <div class="sc__q" role="radiogroup" aria-labelledby={`q-${q.id}`}>
                <p id={`q-${q.id}`}>{q.q}<small class="num">{T.weight} {q.w}</small></p>
                <div class="sc__opts">
                  <label><input type="radio" name={q.id} value="1" /><span>{T.yes}</span></label>
                  <label><input type="radio" name={q.id} value="0.5" /><span>{T.part}</span></label>
                  <label><input type="radio" name={q.id} value="0" /><span>{T.no}</span></label>
                </div>
              </div>
            ))}
          </fieldset>
        ))}
        <button class="btn btn--primary sc__go" type="submit">{T.see}<Icon name="arrow" size={18} class="arrow" /></button>
        <p class="sc__need" data-need hidden>{T.need}</p>
        <p class="sc__priv"><Icon name="lock" size={16} />{T.privacy}</p>
      </form>

      <aside class="sc__res" data-res hidden tabindex="-1" aria-live="polite">
        <span class="eyebrow">{T.result}</span>
        <div class="sc__score"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="52" data-ring /></svg><b class="num" data-score>0</b><small class="num">/ 100</small></div>
        <h2 data-band-t></h2><p data-band-d></p>
        <div class="sc__areas" data-areas></div>
        <h3>{T.prio}</h3>
        <ol class="sc__prio" data-prio></ol>
        <p class="sc__none" data-none hidden>{T.none}</p>
        <div class="sc__ctas">
          <a class="btn btn--primary" data-demo href={url(lang, 'demo/')}>{T.demo}<Icon name="arrow" size={18} class="arrow" /></a>
          {CONFIG.whatsapp && <a class="btn btn--ghost" data-wa href="#" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />{T.wa}</a>}
          <button class="btn btn--ghost" type="button" data-print>{T.print}</button>
          <button class="sc__reset" type="button" data-reset>{T.reset}</button>
        </div>
        <details class="sc__method"><summary>{T.method}</summary><p>{T.methodD}</p></details>
      </aside>
    </div>
    <script type="application/json" data-scan-data set:html={JSON.stringify({ ...data, learn: T.learn, bandsT: T.bands })} />
  </section>
</Base>
<style>
  .sc__in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; max-width: 860px }
  .sc__prog { position: sticky; top: 76px; z-index: 5; display: grid; gap: 8px; padding: 14px 18px; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); font-weight: 600; margin-bottom: 20px }
  .sc__prog i { display: block; height: 6px; border-radius: 9px; background: var(--sand-200); overflow: hidden }
  .sc__prog em { display: block; height: 100%; width: 0; background: var(--green-700); transition: width .4s var(--ease) }
  .sc__area { border: 0; margin: 0 0 26px; padding: 0 }
  .sc__area legend { font-family: 'Alexandria', var(--font); font-weight: 700; font-size: 1.35rem; margin-bottom: 12px }
  .sc__q { padding: 18px 20px; border-radius: var(--r-md); background: var(--surface); border: 1px solid var(--line); margin-bottom: 10px; transition: border-color .3s }
  .sc__q.done { border-color: var(--green-300) }
  .sc__q p { font-weight: 600; display: flex; justify-content: space-between; gap: 12px; align-items: baseline }
  .sc__q small { flex: none; font-weight: 500; font-size: .8rem; color: var(--ink-600); background: var(--sand-100); padding: 2px 10px; border-radius: 99px }
  .sc__opts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px }
  .sc__opts label { position: relative; cursor: pointer }
  .sc__opts input { position: absolute; opacity: 0 }
  .sc__opts span { display: inline-flex; align-items: center; height: 42px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--line); font-weight: 600; font-size: .95rem; transition: all .2s }
  .sc__opts input:checked + span { background: var(--green-900); border-color: var(--green-900); color: var(--sand-100) }
  .sc__opts input[value='0']:checked + span { background: var(--saffron-400); border-color: var(--saffron-400); color: var(--green-950) }
  .sc__opts input:focus-visible + span { outline: 2px solid var(--saffron-400); outline-offset: 2px }
  .sc__go { margin-top: 6px }
  .sc__need { color: var(--crit); font-weight: 600; margin-top: 10px }
  .sc__priv { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: .9rem; margin-top: 16px }
  .sc__res { padding: clamp(24px, 4vw, 44px); border-radius: var(--r-xl); background: var(--green-900); color: var(--sand-100); outline: none }
  .sc__score { position: relative; width: 160px; height: 160px; display: grid; place-items: center; margin: 14px 0 18px }
  .sc__score svg { position: absolute; inset: 0; transform: rotate(-90deg) }
  .sc__score circle { fill: none; stroke: rgba(245, 239, 228, .12); stroke-width: 9 }
  .sc__score circle[data-ring] { stroke: var(--saffron-400); stroke-linecap: round; stroke-dasharray: 326.7; stroke-dashoffset: 326.7; transition: stroke-dashoffset 1.2s var(--ease) }
  .sc__score b { font-family: 'Alexandria', var(--font); font-size: 3rem; line-height: 1 }
  .sc__score small { position: absolute; bottom: 38px; color: var(--green-300); font-size: .85rem }
  .sc__res h2 { font-size: var(--fs-h3) }
  .sc__res > p { color: var(--green-300); margin-top: 4px }
  .sc__areas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 24px 0 }
  .sc__areas div { padding: 14px; border-radius: var(--r-md); background: rgba(245, 239, 228, .06) }
  .sc__areas b { display: block; font-size: 1.4rem }
  .sc__areas i { display: block; height: 5px; border-radius: 9px; background: rgba(245, 239, 228, .12); margin-top: 8px; overflow: hidden }
  .sc__areas em { display: block; height: 100%; background: var(--saffron-400) }
  .sc__res h3 { font-size: 1.15rem; margin-bottom: 10px }
  .sc__prio { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; counter-reset: p }
  .sc__prio li { counter-increment: p; display: grid; grid-template-columns: auto 1fr; gap: 12px; padding: 14px 16px; border-radius: var(--r-md); background: rgba(245, 239, 228, .06) }
  .sc__prio li::before { content: counter(p); width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--saffron-400); color: var(--green-950); font-weight: 700; font-size: .85rem }
  .sc__prio a { color: var(--saffron-400); font-size: .88rem; font-weight: 600 }
  .sc__prio small { display: block; color: var(--green-300) }
  .sc__ctas { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 26px }
  .sc__ctas .btn--ghost { color: var(--sand-100); border-color: rgba(245, 239, 228, .4) }
  .sc__reset { color: var(--green-300); text-decoration: underline; text-underline-offset: 4px; padding: 8px }
  .sc__method { margin-top: 22px; color: var(--green-300); font-size: .92rem }
  .sc__method summary { cursor: pointer; font-weight: 600; color: var(--sand-200) }
  @media (max-width: 640px) { .sc__areas { grid-template-columns: 1fr 1fr } .sc__q p { flex-direction: column; gap: 4px } }
  @media print { :global(header), :global(footer), :global(.mbar), :global(.phero), .sc__form, .sc__ctas { display: none !important } .sc__res { background: #fff !important; color: #000 !important } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-scan]').forEach((root) => {
    const D = JSON.parse(root.querySelector('[data-scan-data]')!.textContent!);
    const form = root.querySelector('form')!;
    const res = root.querySelector<HTMLElement>('[data-res]')!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const total = D.qs.length;
    const answers = () => Object.fromEntries(D.qs.map((q: any) => [q.id, (form.querySelector(`input[name=${q.id}]:checked`) as HTMLInputElement | null)?.value]));
    form.addEventListener('change', (e) => {
      const a = answers(); const n = Object.values(a).filter((v) => v !== undefined).length;
      $('[data-count]').textContent = String(n); $('[data-bar]').style.width = `${(n / total) * 100}%`;
      (e.target as HTMLElement).closest('.sc__q')?.classList.add('done');
      if (n === total) $('[data-need]').hidden = true;
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const a = answers();
      const missing = D.qs.find((q: any) => a[q.id] === undefined);
      if (missing) { $('[data-need]').hidden = false; form.querySelector<HTMLInputElement>(`input[name=${missing.id}]`)?.focus(); return; }
      let score = 0; const per: Record<string, [number, number]> = {};
      D.qs.forEach((q: any) => { const v = parseFloat(a[q.id]); score += q.w * v; per[q.area] = per[q.area] || [0, 0]; per[q.area][0] += q.w * v; per[q.area][1] += q.w; });
      score = Math.round(score);
      const band = D.bands.find((b: any) => score >= b.min);
      $('[data-score]').textContent = String(score);
      $('[data-band-t]').textContent = band.t; $('[data-band-d]').textContent = band.d;
      $('[data-areas]').innerHTML = Object.entries(per).map(([k, [g, m]]) => { const p = Math.round((g / m) * 100); return `<div><small>${D.areas[k]}</small><b class="num">${p}%</b><i><em style="width:${p}%"></em></i></div>`; }).join('');
      const prio = D.qs.filter((q: any) => parseFloat(a[q.id]) < 1).sort((x: any, y: any) => (y.w * (1 - parseFloat(a[y.id]))) - (x.w * (1 - parseFloat(a[x.id])))).slice(0, 5);
      $('[data-prio]').innerHTML = prio.map((q: any) => `<li><div>${q.fix}<small>${D.areas[q.area]}</small><a href="${D.featUrl[q.feat]}">${D.learn}: ${D.feat[q.feat]}</a></div></li>`).join('');
      $('[data-none]').hidden = prio.length > 0;
      const summary = `${D.lang === 'ar' ? 'نتيجة فحص صيت' : 'SAAYT scan result'}: ${score}/100 · ` + Object.entries(per).map(([k, [g, m]]) => `${D.areas[k]} ${Math.round((g / m) * 100)}%`).join(' · ');
      root.querySelector<HTMLAnchorElement>('[data-demo]')!.href = `${D.demo}?scan=${score}`;
      const wa = root.querySelector<HTMLAnchorElement>('[data-wa]'); if (wa && D.wa) wa.href = `https://wa.me/${D.wa}?text=${encodeURIComponent(summary)}`;
      res.hidden = false;
      requestAnimationFrame(() => { (root.querySelector('[data-ring]') as SVGCircleElement).style.strokeDashoffset = String(326.7 * (1 - score / 100)); });
      res.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }); res.focus({ preventScroll: true });
    });
    $('[data-print]').addEventListener('click', () => window.print());
    $('[data-reset]').addEventListener('click', () => { form.reset(); form.querySelectorAll('.done').forEach((x) => x.classList.remove('done')); $('[data-count]').textContent = '0'; $('[data-bar]').style.width = '0'; res.hidden = true; form.scrollIntoView({ behavior: 'smooth' }); });
  });
</script>

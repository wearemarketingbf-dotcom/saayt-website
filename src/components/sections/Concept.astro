---
import { type Lang } from '../../i18n/util';
import { HOME } from '../../data/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const C = HOME[lang].concept;
---
<section class="section section--dark concept" aria-labelledby="concept-h">
  <div class="wrap concept__in">
    <div class="concept__viz" aria-hidden="true">
      <canvas data-net width="720" height="720"></canvas>
    </div>
    <div>
      <span class="eyebrow" data-reveal>{C.eyebrow}</span>
      <h2 class="h2" id="concept-h" data-reveal>{C.h2}</h2>
      <p class="lead" data-reveal>{C.lead}</p>
      <div class="concept__pts" data-stagger="100">
        {C.points.map((p) => <div class="concept__pt"><b>{p.t}</b><p>{p.d}</p></div>)}
      </div>
    </div>
  </div>
</section>

<style>
  .concept__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center }
  .concept__viz { aspect-ratio: 1; width: 100%; max-width: 560px; justify-self: center }
  .concept__viz canvas { width: 100%; height: 100% }
  .concept__pts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 34px }
  .concept__pt { padding: 18px; border-radius: var(--r-md); border: 1px solid rgba(245, 239, 228, .12); background: rgba(245, 239, 228, .03) }
  .concept__pt b { color: var(--saffron-400); font-size: 1.05rem }
  .concept__pt p { color: var(--green-300); font-size: .95rem; margin-top: 2px }
  @media (max-width: 900px) { .concept__in { grid-template-columns: 1fr } .concept__viz { max-width: 420px } }
  @media (max-width: 420px) { .concept__pts { grid-template-columns: 1fr } }
</style>

<script>
  // "One star brings every branch together": scattered shop icons drift, then snap into rings around the star
  const cv = document.querySelector<HTMLCanvasElement>('[data-net]');
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const S = 720; const dpr = Math.min(2, devicePixelRatio || 1);
    cv.width = S * dpr; cv.height = S * dpr; ctx.scale(dpr, dpr);
    let seed = 11; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const rings = [[120, 8], [205, 13], [290, 17]] as const;
    const N: { x: number; y: number; ox: number; oy: number; ph: number; c: string; ri: number }[] = [];
    const tints = ['#7AAEA6', '#A1A19C', '#D3B888', '#50958B', '#C29E5B'];
    rings.forEach(([r, c], ri) => { for (let j = 0; j < c; j++) { const a = (j / c) * Math.PI * 2 + ri * .4; N.push({ x: 360 + (rnd() * 2 - 1) * 320, y: 360 + (rnd() * 2 - 1) * 320, ox: 360 + Math.cos(a) * r, oy: 360 + Math.sin(a) * r, ph: rnd() * 6.28, c: tints[(j + ri) % 5], ri }); } });
    const star = (x: number, y: number, r: number) => { ctx.beginPath(); ctx.moveTo(x, y - r); ctx.quadraticCurveTo(x, y, x + r, y); ctx.quadraticCurveTo(x, y, x, y + r); ctx.quadraticCurveTo(x, y, x - r, y); ctx.quadraticCurveTo(x, y, x, y - r); ctx.fill(); };
    const shop = (x: number, y: number, s: number, aw: string) => { ctx.fillStyle = '#F5EFE4'; ctx.fillRect(x - 9 * s, y - 2 * s, 18 * s, 13 * s); ctx.fillStyle = aw; ctx.beginPath(); ctx.moveTo(x - 11 * s, y - 9 * s); ctx.lineTo(x + 11 * s, y - 9 * s); ctx.lineTo(x + 10 * s, y - 2 * s); ctx.lineTo(x - 10 * s, y - 2 * s); ctx.fill(); ctx.fillStyle = '#0F3D36'; ctx.fillRect(x - 3 * s, y + 4 * s, 6 * s, 7 * s); };
    const ease = (t: number) => 1 - Math.pow(1 - Math.min(1, Math.max(0, t)), 3);
    let t0 = 0; let started = false; let vis = false; let raf = 0; let pausedAt = 0;
    const draw = (now: number) => {
      if (!t0) t0 = now; if (pausedAt) { t0 += now - pausedAt; pausedAt = 0; } const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, S, S);
      const order = reduce ? 1 : ease((t - 1.2) / 1.6);
      const glow = reduce ? 1 : ease((t - 0.9) / .8);
      // rings
      ctx.strokeStyle = 'rgba(242,163,58,.18)'; ctx.lineWidth = 1;
      rings.forEach(([r]) => { ctx.beginPath(); ctx.arc(360, 360, r * order, 0, Math.PI * 2); ctx.stroke(); });
      N.forEach((p, i) => {
        const chaos = 1 - order;
        const x = p.x + (p.ox - p.x) * order + Math.sin(t * 1.6 + p.ph) * 10 * chaos;
        const y = p.y + (p.oy - p.y) * order + Math.cos(t * 1.3 + p.ph) * 8 * chaos;
        const turn = reduce ? 1 : ease((t - 2.6 - p.ri * .35 - i * .01) / .5);
        if (order > .2) { ctx.strokeStyle = `rgba(242,163,58,${.35 * turn})`; ctx.beginPath(); ctx.moveTo(360, 360); ctx.lineTo(x, y); ctx.stroke(); }
        if (turn < 1) shop(x, y, (1 - turn) * (0.9 + .3 * chaos), order > .6 ? '#F2A33A' : p.c);
        if (turn > 0) { ctx.fillStyle = '#F2A33A'; star(x, y, 9 * turn); }
      });
      ctx.fillStyle = '#F2A33A'; star(360, 360, 46 * glow + Math.sin(t * 2) * 1.5 * glow);
      raf = 0; if (!reduce && vis) raf = requestAnimationFrame(draw); else if (!reduce) pausedAt = now;
    };
    new IntersectionObserver(([e]) => { vis = e.isIntersecting; if (vis && !raf && (!started || !reduce)) { started = true; raf = requestAnimationFrame(draw); } }, { threshold: [0, .3] }).observe(cv);
  }
</script>

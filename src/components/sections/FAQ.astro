---
import Icon from '../Icon.astro';
interface Props { eyebrow: string; title: string; items: readonly { q: string; a: string }[]; id?: string }
const { eyebrow, title, items, id = 'faq' } = Astro.props;
---
<section class="section faq" aria-labelledby={`${id}-h`}>
  <div class="wrap faq__in">
    <div>
      <span class="eyebrow" data-reveal>{eyebrow}</span>
      <h2 class="h2" id={`${id}-h`} data-reveal>{title}</h2>
    </div>
    <div class="faq__list" data-stagger="70">
      {items.map((it) => (
        <details class="faq__it">
          <summary><span>{it.q}</span><Icon name="plus" size={20} class="faq__ic" /></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq__in { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start }
  .faq__list { display: grid; gap: 10px }
  .faq__it { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 0 22px; transition: border-color .3s }
  .faq__it[open] { border-color: var(--green-700) }
  .faq__it summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-weight: 600; font-size: 1.06rem }
  .faq__it summary::-webkit-details-marker { display: none }
  :global(.faq__ic) { flex: none; transition: transform .35s var(--ease); color: var(--green-700) }
  .faq__it[open] :global(.faq__ic) { transform: rotate(45deg) }
  .faq__it p { padding-bottom: 20px; color: var(--muted) }
  @media (max-width: 900px) { .faq__in { grid-template-columns: 1fr } }
</style>

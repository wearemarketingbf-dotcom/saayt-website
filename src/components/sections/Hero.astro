---
import Icon from '../Icon.astro';
import Stars from '../ui/Stars.astro';
import { type Lang, url, asset } from '../../i18n/util';
import { HOME } from '../../data/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
const H = HOME[lang].hero;
const C = HOME[lang].heroCard;
---
<section class="hero section--deep" aria-labelledby="hero-h">
  <div class="hero__media" aria-hidden="true">
    <video class="hero__video" muted loop playsinline preload="none" poster={asset('img/hero-poster.webp')} data-sm={asset('media/hero-loop-sm.mp4')} data-lg={asset('media/hero-loop.mp4')}></video>
    <div class="hero__veil"></div>
  </div>
  <div class="hero__in wrap">
    <div class="hero__copy">
      <span class="eyebrow hero__eb" data-h="1">{H.eyebrow}</span>
      <h1 id="hero-h" class="hero__h1">
        <span class="hero__line"><span data-h="2">{H.h1a}</span></span>
        <span class="hero__line"><span data-h="3" class="hl">{H.h1b}</span></span>
      </h1>
      <p class="hero__sub" data-h="4">{H.sub}</p>
      <div class="hero__ctas" data-h="5">
        <a class="btn btn--primary" href={url(lang, 'demo/')}>{H.cta1}<Icon name="arrow" size={18} class="arrow" /></a>
        <a class="btn btn--ghost" href={url(lang, 'free-scan/')}>{H.cta2}</a>
      </div>
      <p class="hero__note" data-h="6"><Icon name="shield" size={18} />{H.note}</p>
    </div>

    <div class="hero__card" data-h="7" data-herocard>
      <div class="hc__top"><span class="hc__today"><span class="hc__pulse"></span>{C.today}</span><span class="mock__tag">{C.label}</span></div>
      <div class="hc__review">
        <div class="hc__rh"><b>{C.branch}</b><Stars n={3} /><small>{C.time}</small></div>
        <p>{C.review}</p>
      </div>
      <div class="hc__sug">
        <span class="hc__lbl"><Icon name="star" size={12} />{C.suggested}</span>
        <p class="hc__reply" data-text={C.reply}>{C.reply}</p>
        <div class="hc__acts">
          <span class="btn btn--primary hc__ok"><span class="hc__a1">{C.approve}</span><span class="hc__a2"><Icon name="check" size={16} />{C.approved}</span></span>
          <span class="btn hc__edit">{C.edit}</span>
          <span class="hc__wait">{C.waiting}</span>
        </div>
      </div>
      <div class="hc__rows">
        {C.rows.map((r) => <div class="hc__row"><span class={`dotc dotc--${r.tone}`}></span><b>{r.b}</b><span>{r.s}</span></div>)}
      </div>
    </div>
  </div>
  <div class="hero__trust wrap" data-h="8">
    {HOME[lang].trust.map((t) => <span class="hero__ti"><Icon name="star" size={12} />{t}</span>)}
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(100svh, 980px); display: grid; grid-template-rows: 1fr auto; padding-top: 120px; overflow: hidden; isolation: isolate }
  .hero__media { position: absolute; inset: 0; z-index: -1 }
  .hero__video { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04) }
  .hero__veil { position: absolute; inset: 0; background: rgba(10, 41, 36, .62) }
  html[dir='rtl'] .hero__veil { background: rgba(10, 41, 36, .62) }
  .hero__in { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 5vw, 80px); align-items: center; padding-block: 40px }
  .hero__h1 { font-family: 'Alexandria', var(--font); font-weight: 700; font-size: var(--fs-hero); line-height: 1.12; margin-top: 18px }
  html[lang='en'] .hero__h1 { letter-spacing: -0.03em; line-height: 1.02 }
  .hero__line { display: block; overflow: hidden; padding-block: .06em }
  .hero__line > span { display: inline-block }
  .hero__sub { margin-top: 22px; font-size: var(--fs-lead); color: var(--sand-200); max-width: 34em }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px }
  .hero__ctas .btn--ghost { color: var(--sand-100); border-color: rgba(245, 239, 228, .45) }
  .hero__note { display: flex; align-items: center; gap: 8px; margin-top: 22px; font-size: .92rem; color: var(--green-300) }
  .hero__card { background: var(--surface); color: var(--text); border-radius: var(--r-xl); padding: 20px; display: grid; gap: 12px; box-shadow: 0 60px 120px -40px rgba(0, 0, 0, .55); max-width: 470px; justify-self: end; width: 100% }
  .hc__top { display: flex; justify-content: space-between; align-items: center }
  .hc__today { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: .95rem }
  .hc__pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--saffron-400); box-shadow: 0 0 0 0 rgba(242, 163, 58, .6); animation: pulse 2s infinite }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(242, 163, 58, 0) } 100% { box-shadow: 0 0 0 0 rgba(242, 163, 58, 0) } }
  .hc__review { padding: 13px 14px; border: 1px solid var(--line); border-radius: 16px; font-size: .9rem; line-height: 1.6 }
  .hc__rh { display: flex; align-items: center; gap: 10px; margin-bottom: 4px }
  .hc__rh small { margin-inline-start: auto; color: var(--ink-600); font-size: .76rem }
  .hc__sug { padding: 14px; border-radius: 16px; background: var(--green-900); color: var(--sand-100) }
  .hc__lbl { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; font-weight: 600; color: var(--saffron-400) }
  .hc__reply { margin-top: 6px; font-size: .9rem; line-height: 1.65; min-height: 6.6em }
  .hc__reply.typing::after { content: ''; display: inline-block; width: 2px; height: 1em; background: var(--saffron-400); margin-inline-start: 2px; vertical-align: -2px; animation: blink .8s steps(2) infinite }
  @keyframes blink { 50% { opacity: 0 } }
  .hc__acts { display: flex; align-items: center; gap: 8px; margin-top: 12px; flex-wrap: wrap }
  .hc__acts .btn { --h: 40px; padding: 0 16px; font-size: .86rem; pointer-events: none }
  .hc__edit { border: 1.5px solid rgba(245, 239, 228, .3) }
  .hc__wait { margin-inline-start: auto; font-size: .76rem; color: var(--green-300) }
  .hc__a2 { display: none; align-items: center; gap: 6px }
  .hero__card.ok .hc__a1, .hero__card.ok .hc__edit, .hero__card.ok .hc__wait { display: none }
  .hero__card.ok .hc__a2 { display: inline-flex }
  .hero__card.ok .hc__ok { background: var(--green-300); color: var(--green-950) }
  .hc__rows { display: grid; gap: 6px }
  .hc__row { display: grid; grid-template-columns: auto auto 1fr; gap: 10px; align-items: center; padding: 9px 12px; border-radius: 12px; background: var(--sand-100); font-size: .84rem }
  .hc__row span:last-child { color: var(--ink-600); text-align: end }
  .dotc { width: 9px; height: 9px; border-radius: 50% }
  .dotc--accent { background: var(--saffron-400) } .dotc--ok { background: var(--green-500) }
  .hero__trust { display: flex; flex-wrap: wrap; gap: 10px 28px; padding-block: 26px 34px; border-top: 1px solid rgba(245, 239, 228, .14); color: var(--sand-200); font-size: .95rem }
  .hero__ti { display: inline-flex; align-items: center; gap: 8px }
  .hero__ti :global(.icon) { color: var(--saffron-400) }
  /* entrance (JS adds .ready); without JS everything is visible */
  :global(.js) .hero [data-h] { opacity: 0; transform: translateY(24px) }
  :global(.js) .hero .hero__line > span[data-h] { transform: translateY(105%); opacity: 1 }
  :global(.js) .hero.ready [data-h], :global(.js) .hero.ready .hero__line > span[data-h] { opacity: 1; transform: none; transition: opacity 1s var(--ease), transform 1.1s var(--ease) }
  .hero.ready [data-h='2'] { transition-delay: .1s } .hero.ready [data-h='3'] { transition-delay: .22s }
  .hero.ready [data-h='4'] { transition-delay: .4s } .hero.ready [data-h='5'] { transition-delay: .52s }
  .hero.ready [data-h='6'] { transition-delay: .64s } .hero.ready [data-h='7'] { transition-delay: .5s }
  .hero.ready [data-h='8'] { transition-delay: .8s }
  @media (prefers-reduced-motion: reduce) { :global(.js) .hero [data-h], :global(.js) .hero .hero__line > span[data-h] { opacity: 1; transform: none } }
  @media (max-width: 980px) {
    .hero { min-height: auto; padding-top: 104px }
    .hero__in { grid-template-columns: 1fr }
    .hero__card { justify-self: stretch; max-width: none }
  }
  @media (max-width: 560px) { .hero__ctas .btn { flex: 1 1 100% } .hc__row span:last-child { display: none } .hc__row { grid-template-columns: auto 1fr } }
</style>

<script>
  const hero = document.querySelector('.hero') as HTMLElement;
  requestAnimationFrame(() => requestAnimationFrame(() => hero?.classList.add('ready')));
  const card = document.querySelector<HTMLElement>('[data-herocard]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (card && !reduce) {
    const p = card.querySelector<HTMLElement>('.hc__reply')!;
    const text = p.dataset.text || '';
    const cycle = () => {
      card.classList.remove('ok'); p.textContent = ''; p.classList.add('typing');
      let i = 0;
      const step = () => {
        i += 2; p.textContent = text.slice(0, i);
        if (i < text.length) setTimeout(step, 24);
        else { p.classList.remove('typing'); setTimeout(() => card.classList.add('ok'), 1400); setTimeout(cycle, 7500); }
      };
      setTimeout(step, 900);
    };
    setTimeout(cycle, 600);
  }
  // pick one video source for the screen size so phones only download the small file
  const v = document.querySelector<HTMLVideoElement>('.hero__video');
  const saveData = (navigator as any).connection?.saveData;
  if (v && !reduce && !saveData) {
    v.src = matchMedia('(max-width: 760px)').matches ? v.dataset.sm! : v.dataset.lg!;
    v.play().catch(() => {});
  }
</script>

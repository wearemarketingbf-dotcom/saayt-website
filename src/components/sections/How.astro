---
import Icon from '../Icon.astro';
import { type Lang, url } from '../../i18n/util';
import { HOME } from '../../data/home';
interface Props { lang: Lang; more?: boolean }
const { lang, more = true } = Astro.props;
const H = HOME[lang].how;
---
<section class="section how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="section-head section-head--center">
      <span class="eyebrow" data-reveal>{H.eyebrow}</span>
      <h2 class="h2" id="how-h" data-reveal>{H.h2}</h2>
    </div>
    <ol class="how__steps" data-stagger="140">
      {H.steps.map((s, i) => (
        <li class="how__step">
          <span class="how__n num">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
    {more && <div class="how__more" data-reveal><a class="btn btn--light-ghost" href={url(lang, 'how-it-works/')}>{H.more}<Icon name="arrow" size={18} class="arrow" /></a></div>}
  </div>
</section>
<style>
  .how__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: s; position: relative }
  .how__steps::before { content: ''; position: absolute; top: 36px; inset-inline: 12%; border-top: 2px dashed var(--saffron-400); opacity: .6 }
  .how__step { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 28px 26px }
  .how__n { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--green-900); color: var(--saffron-400); font-weight: 700; font-size: 1.25rem; margin-bottom: 18px }
  .how__step h3 { font-size: var(--fs-h3) }
  .how__step p { color: var(--muted); margin-top: 8px }
  .how__more { display: flex; justify-content: center; margin-top: 36px }
  @media (max-width: 860px) { .how__steps { grid-template-columns: 1fr } .how__steps::before { display: none } }
</style>
